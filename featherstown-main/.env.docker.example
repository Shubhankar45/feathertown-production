# ==============================================================================
# FeatherTown Docker Environment Configuration (.env.docker)
# Copy this file to .env before running `docker compose up --build`
# ==============================================================================

# ── 1. Database Configuration ──
# 🟢 OPTION A: MongoDB Atlas (Cloud Managed - RECOMMENDED FOR PRODUCTION)
# Paste your connection string from MongoDB Atlas Dashboard (Replace USER, PASSWORD, CLUSTER, DB):
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/feathertown?retryWrites=true&w=majority

# ⚪ OPTION B: Local MongoDB Docker Container (For local offline testing)
# Uncomment the line below if you want to use the local mongo container in docker-compose:
# MONGO_URI=mongodb://mongo:27017/feathertown

# ── 2. Server Configuration ──
PORT=5000
NODE_ENV=production
JWT_SECRET=generate-a-strong-secret-key-at-least-32-characters-long
JWT_EXPIRES_IN=8h

# ── 3. Razorpay Payments (Optional) ──
# Leave empty if not using online card/UPI payments (falls back to Cash on Delivery)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── 4. Customer Google OAuth Login (Optional) ──
# Leave empty to run in guest mode without Google Sign-In
GOOGLE_CLIENT_ID=

# ── 5. Email Notifications (SMTP) ──
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=support@feathertown.online
MAIL_PASS=your-mailbox-password
MAIL_FROM=support@feathertown.online
MAIL_FROM_NAME=FeatherTown
