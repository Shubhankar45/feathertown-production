# ==============================================================================
# FeatherTown Root Git Ignore (.gitignore)
# ==============================================================================

# ── Environment & Secrets (NEVER COMMIT) ──
.env
.env.*
!.env.example
!.env.docker.example
!.env.*.example
*.pem
*.key
*.cert
*.crt

# ── Python Bytecode & Virtual Environments ──
__pycache__/
**/*.py[cod]
**/*$py.class
*.so
.Python
.venv/
**/venv/
**/ENV/
**/env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# ── Node.js Dependencies & Build Outputs ──
**/node_modules/
**/dist/
frontend/dist/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Scratch & Test Scripts ──
scratch/
**/scratch/

# ── Documentation Files & Guides ──
*.md
**/*.md
docs/
**/docs/
documentation/
**/documentation/
*.doc
*.docx
*.pdf
AWS_EC2_DEPLOYMENT.md
DOCKER_GUIDE.md
SETUP_ADMIN_AND_SHOP.md
README.md

# ── OS & Editor Artifacts ──
.DS_Store
Thumbs.db
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.log
