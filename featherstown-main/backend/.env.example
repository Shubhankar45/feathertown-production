# ── Database ──
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/feathertown?retryWrites=true&w=majority

# ── Server ──
PORT=5000
NODE_ENV=development

# ── Admin auth (JWT) ──
# Generate a strong random secret, e.g.: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h

# ── Razorpay (accessories checkout) — OPTIONAL ──
# Leave both blank/unset to disable online payment: checkout automatically
# falls back to Cash on Delivery, and everything else keeps working.
# From the Razorpay Dashboard → Settings → API Keys. Use test keys while developing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Customer login — Google OAuth only — OPTIONAL ──
# Leave blank/unset to disable customer sign-in: the "Sign in with Google"
# button is hidden and shopping/checkout continue to work as a guest.
# Create one at https://console.cloud.google.com/apis/credentials
# (OAuth client ID → Web application). Add both your dev and prod URLs
# under "Authorized JavaScript origins" (no path, no trailing slash).
GOOGLE_CLIENT_ID=

# ── Outbound email (welcome emails) ──
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=support@feathertown.online
MAIL_PASS=your-mailbox-password
MAIL_FROM=support@feathertown.online
MAIL_FROM_NAME=FeatherTown 🦜
