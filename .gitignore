# ==============================================================================
# Root Git Ignore (.gitignore)
# ==============================================================================

# ── Environment & Secrets (NEVER COMMIT) ──
.env
.env.*
!.env.example
!.env.docker.example
*.pem
*.key
*.cert
*.crt
id_rsa*

# ── Documentation Files & Guides ──
*.md
**/*.md
docs/
**/docs/
documentation/
**/documentation/
*.doc
*.docx
*.pdf

# ── Python ──
__pycache__/
**/*.py[cod]
.venv/
**/venv/

# ── Node.js ──
**/node_modules/
**/dist/
.vite/
*.log

# ── OS & IDE ──
.DS_Store
Thumbs.db
.vscode/
.idea/
